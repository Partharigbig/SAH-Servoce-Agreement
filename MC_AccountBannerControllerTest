/**
 * @description Test class for MC_AccountBannerController.
 * Requires @TestVisible on MC_AccountBannerController.calculateAge.
 */
@isTest
private class MC_AccountBannerControllerTest {

    private static final String FUNDING_TYPE_HACC_PYP = 'HACC-PYP';
    private static final String FUNDING_TYPE_CHSP     = 'CHSP';
    private static final String STATUS_ACTIVE         = 'Active';
    private static final String BANNER_MESSAGE        = 'Client is 65 years old';
    private static final String FALLBACK_FUNDING_SOURCE = 'Block Funding';

    private static final String ADMIN_USERNAME_PREFIX = 'mcbannertest.admin.';
    private static final String MIN_USERNAME_PREFIX   = 'mcbannertest.min.';

    private static maica_cc__Price_List__c priceList;
    private static Account fundingAdmin;
    private static Map<String, String> fundingSourceByType = new Map<String, String>();

    // Shape of a serialized Schema.PicklistEntry (validFor is not exposed directly in Apex)
    private class PicklistEntryInfo {
        public Boolean active;
        public Boolean defaultValue;
        public String label;
        public String value;
        public String validFor;
    }

    // ------------------------------------------------------------------
    // Setup: users only (setup objects) to avoid MIXED_DML_OPERATION
    // ------------------------------------------------------------------
    @TestSetup
    static void setupUsers() {
        Long stamp = Datetime.now().getTime();
        List<User> users = new List<User>();

        Profile adminProfile = [SELECT Id FROM Profile WHERE Name = 'System Administrator' LIMIT 1];
        users.add(buildUser(adminProfile.Id, 'bnradm', ADMIN_USERNAME_PREFIX + stamp + '@mc-test.example.com'));

        List<Profile> minProfiles = [SELECT Id FROM Profile WHERE Name = 'Minimum Access - Salesforce' LIMIT 1];
        if (!minProfiles.isEmpty()) {
            users.add(buildUser(minProfiles[0].Id, 'bnrmin', MIN_USERNAME_PREFIX + stamp + '@mc-test.example.com'));
        }
        insert users;
    }

    private static User buildUser(Id profileId, String alias, String username) {
        return new User(
            FirstName         = 'Banner',
            LastName          = 'TestUser',
            Alias             = alias,
            Email             = 'bannertest@mc-test.example.com',
            Username          = username,
            ProfileId         = profileId,
            TimeZoneSidKey    = 'Australia/Perth',
            LocaleSidKey      = 'en_AU',
            EmailEncodingKey  = 'UTF-8',
            LanguageLocaleKey = 'en_US'
        );
    }

    private static User getUser(String usernamePrefix) {
        String pattern = usernamePrefix + '%';
        List<User> users = [SELECT Id FROM User WHERE Username LIKE :pattern LIMIT 1];
        return users.isEmpty() ? null : users[0];
    }

    // ------------------------------------------------------------------
    // Data helpers
    // ------------------------------------------------------------------

    /**
     * Birthdate sits mid-year (N years + 6 months ago) so the age never depends
     * on the exact day/timezone boundary the Age_Formula__c ticks over on.
     */
    private static Date birthdateForAge(Integer years) {
        return Date.today().addYears(-years).addMonths(-6);
    }

    private static Account createPersonAccountWithAge(Integer age) {
        Account acc = MC_TestDataFactory.createPersonAccount();
        acc.PersonBirthdate = birthdateForAge(age);
        update acc;

        Account queried = [SELECT Age_Formula__c FROM Account WHERE Id = :acc.Id];
        Assert.areEqual(age, Integer.valueOf(queried.Age_Formula__c),
            'Setup check: Age_Formula__c should be derived from PersonBirthdate');
        return acc;
    }

    private static Account createEligibleAccount() {
        return createPersonAccountWithAge(65);
    }

    private static Id getPersonContactId(Id accountId) {
        return [SELECT PersonContactId FROM Account WHERE Id = :accountId].PersonContactId;
    }

    private static maica_cc__Price_List__c getPriceList() {
        if (priceList == null) {
            priceList = new maica_cc__Price_List__c(
                Name                           = 'Test Pricebook',
                maica_cc__Funding_Source__c    = 'Self Funded',
                maica_cc__Pricing_Structure__c = 'Default',
                maica_cc__Active__c            = true
            );
            insert priceList;
        }
        return priceList;
    }

    private static Account getFundingAdmin() {
        if (fundingAdmin == null) {
            fundingAdmin = MC_TestDataFactory.grampiansAccountEmail();
            // Validation rule: Funding Administrator must have a Billing Address
            fundingAdmin.BillingStreet     = '1 Test Street';
            fundingAdmin.BillingCity       = 'Melbourne';
            fundingAdmin.BillingState      = 'Victoria';
            fundingAdmin.BillingPostalCode = '3000';
            fundingAdmin.BillingCountry    = 'Australia';
            update fundingAdmin;
        }
        return fundingAdmin;
    }

    // ---- Dependent picklist: find the Funding_Source__c that allows a Funding_Type__c ----
    private static String resolveFundingSource(String fundingType) {
        if (fundingSourceByType.containsKey(fundingType)) {
            return fundingSourceByType.get(fundingType);
        }
        String resolved = FALLBACK_FUNDING_SOURCE;
        List<Schema.PicklistEntry> controllers =
            maica_cc__Service_Agreement__c.maica_cc__Funding_Source__c.getDescribe().getPicklistValues();
        List<Schema.PicklistEntry> dependents =
            maica_cc__Service_Agreement__c.maica_cc__Funding_Type__c.getDescribe().getPicklistValues();
        List<PicklistEntryInfo> infos = (List<PicklistEntryInfo>) JSON.deserialize(
            JSON.serialize(dependents), List<PicklistEntryInfo>.class);

        Boolean found = false;
        for (PicklistEntryInfo info : infos) {
            if (found || info.value != fundingType || info.validFor == null) {
                continue;
            }
            for (Integer i = 0; i < controllers.size(); i++) {
                if (controllers[i].isActive() && isBitSet(info.validFor, i)) {
                    resolved = controllers[i].getValue();
                    found = true;
                    break;
                }
            }
        }
        fundingSourceByType.put(fundingType, resolved);
        return resolved;
    }

    private static Boolean isBitSet(String validFor, Integer index) {
        String hex = EncodingUtil.convertToHex(EncodingUtil.base64Decode(validFor));
        Integer start = (index / 8) * 2;
        if (hex.length() < start + 2) {
            return false;
        }
        Integer byteValue = hexToInt(hex.substring(start, start + 1)) * 16
                          + hexToInt(hex.substring(start + 1, start + 2));
        return (byteValue & (128 >> Math.mod(index, 8))) != 0;
    }

    private static Integer hexToInt(String hexChar) {
        return '0123456789abcdef'.indexOf(hexChar.toLowerCase());
    }

    // ---- Status: set it directly if the field is writable, otherwise dates drive it ----
    private static String getInactiveStatus() {
        for (Schema.PicklistEntry e :
                maica_cc__Service_Agreement__c.maica_cc__Status__c.getDescribe().getPicklistValues()) {
            if (e.isActive() && e.getValue() != STATUS_ACTIVE) {
                return e.getValue();
            }
        }
        return null;
    }

    private static maica_cc__Service_Agreement__c createAgreement(
        Account acc, String fundingType, Boolean isActive
    ) {
        maica_cc__Service_Agreement__c sa = new maica_cc__Service_Agreement__c(
            Name                               = 'Test Service Agreement',
            maica_cc__Participant__c           = getPersonContactId(acc.Id),
            maica_cc__Service_Provider__c      = acc.Id,
            maica_cc__Funding_Administrator__c = getFundingAdmin().Id,
            maica_cc__Funding_Source__c        = resolveFundingSource(fundingType),
            maica_cc__Funding_Type__c          = fundingType,
            maica_cc__Price_List__c            = getPriceList().Id,
            Opportunity_Owner_Email__c         = 'test@test.com',
            maica_cc__Start_Date__c            = isActive ? Date.today().addDays(-1) : Date.today().addDays(-30),
            maica_cc__End_Date__c              = isActive ? Date.today().addDays(10) : Date.today().addDays(-1)
        );
        if (maica_cc__Service_Agreement__c.maica_cc__Status__c.getDescribe().isCreateable()) {
            sa.put('maica_cc__Status__c', isActive ? STATUS_ACTIVE : getInactiveStatus());
        }
        insert sa;

        maica_cc__Service_Agreement__c queried =
            [SELECT maica_cc__Status__c FROM maica_cc__Service_Agreement__c WHERE Id = :sa.Id];
        Assert.areEqual(isActive, queried.maica_cc__Status__c == STATUS_ACTIVE,
            'Setup check: agreement Status mismatch. Actual Status: ' + queried.maica_cc__Status__c);
        return sa;
    }

    /** Runs the controller as the admin test user (WITH USER_MODE needs real access). */
    private static MC_AccountBannerController.BannerResult runBanner(Id accountId) {
        MC_AccountBannerController.BannerResult result;
        System.runAs(getUser(ADMIN_USERNAME_PREFIX)) {
            Test.startTest();
            result = MC_AccountBannerController.getBannerInfo(accountId);
            Test.stopTest();
        }
        return result;
    }

    private static void assertNoBanner(MC_AccountBannerController.BannerResult result, String reason) {
        Assert.isNotNull(result, 'Result should never be null');
        Assert.isFalse(result.showBanner, reason);
        Assert.isNull(result.message, 'Message should be null when the banner is hidden');
    }

    private static void assertBanner(MC_AccountBannerController.BannerResult result, String reason) {
        Assert.isNotNull(result, 'Result should never be null');
        Assert.isTrue(result.showBanner, reason);
        Assert.areEqual(BANNER_MESSAGE, result.message, 'Banner message mismatch');
    }

    // ------------------------------------------------------------------
    // Tests
    // ------------------------------------------------------------------
    @isTest
    static void testNullAccountId_ReturnsNoBanner() {
        assertNoBanner(runBanner(null), 'Null accountId should not show the banner');
    }

    @isTest
    static void testAccountWithoutContact_ReturnsNoBanner() {
        Account acc = MC_TestDataFactory.grampiansAccountEmail();
        assertNoBanner(runBanner(acc.Id), 'Account with no contact should not show the banner');
    }

    @isTest
    static void testAge64_ReturnsNoBanner() {
        Account acc = createPersonAccountWithAge(64);
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        assertNoBanner(runBanner(acc.Id), 'Age 64 should not show the banner');
    }

    @isTest
    static void testAge66_ReturnsNoBanner() {
        Account acc = createPersonAccountWithAge(66);
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        assertNoBanner(runBanner(acc.Id), 'Age 66 should not show the banner');
    }

    @isTest
    static void testEligibleAge_NoAgreements_ReturnsNoBanner() {
        Account acc = createEligibleAccount();
        assertNoBanner(runBanner(acc.Id), 'No agreements should not show the banner');
    }

    @isTest
    static void testActiveHaccPypOnly_ShowsBanner() {
        Account acc = createEligibleAccount();
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        assertBanner(runBanner(acc.Id), 'Active HACC-PYP without CHSP should show the banner');
    }

    @isTest
    static void testActiveHaccPypAndActiveChsp_ReturnsNoBanner() {
        Account acc = createEligibleAccount();
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        createAgreement(acc, FUNDING_TYPE_CHSP, true);
        assertNoBanner(runBanner(acc.Id), 'Active CHSP alongside HACC-PYP should suppress the banner');
    }

    @isTest
    static void testActiveChspOnly_ReturnsNoBanner() {
        Account acc = createEligibleAccount();
        createAgreement(acc, FUNDING_TYPE_CHSP, true);
        assertNoBanner(runBanner(acc.Id), 'Active CHSP only should not show the banner');
    }

    @isTest
    static void testInactiveHaccPyp_ReturnsNoBanner() {
        Account acc = createEligibleAccount();
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, false);
        assertNoBanner(runBanner(acc.Id), 'Inactive HACC-PYP should not count');
    }

    @isTest
    static void testActiveHaccPypInactiveChsp_ShowsBanner() {
        Account acc = createEligibleAccount();
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        createAgreement(acc, FUNDING_TYPE_CHSP, false);
        assertBanner(runBanner(acc.Id), 'Inactive CHSP should not suppress the banner');
    }

    @isTest
    static void testMultipleActiveHaccPyp_ShowsBanner() {
        Account acc = createEligibleAccount();
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, true);
        createAgreement(acc, FUNDING_TYPE_HACC_PYP, false);
        assertBanner(runBanner(acc.Id), 'Multiple HACC-PYP agreements should still show the banner');
    }

    @isTest
    static void testAgreementOnDifferentParticipant_ReturnsNoBanner() {
        Account eligibleAcc = createEligibleAccount();
        Account otherAcc    = createEligibleAccount();
        createAgreement(otherAcc, FUNDING_TYPE_HACC_PYP, true);
        assertNoBanner(runBanner(eligibleAcc.Id), 'Another participant\'s agreement must not trigger the banner');
    }

    @isTest
    static void testUserWithoutAccess_ThrowsQueryException() {
        Account acc = createEligibleAccount();
        User minUser = getUser(MIN_USERNAME_PREFIX);
        if (minUser == null) {
            return; // 'Minimum Access - Salesforce' profile not available in this org
        }

        Boolean exceptionThrown = false;
        System.runAs(minUser) {
            Test.startTest();
            try {
                MC_AccountBannerController.getBannerInfo(acc.Id);
            } catch (QueryException e) {
                exceptionThrown = true;
            }
            Test.stopTest();
        }
        Assert.isTrue(exceptionThrown, 'WITH USER_MODE should block a user with no object access');
    }

    // ------------------------------------------------------------------
    // calculateAge (@TestVisible on the controller method)
    // ------------------------------------------------------------------
    @isTest
    static void testCalculateAge_BirthdayLaterThisYear_MonthAhead() {
        Date birthdate = Date.today().addYears(-30).addMonths(1);
        Assert.areEqual(29, MC_AccountBannerController.calculateAge(birthdate),
            'Birthday month not reached yet: age should be one less');
    }

    @isTest
    static void testCalculateAge_BirthdayTomorrow() {
        Date birthdate = Date.today().addYears(-30).addDays(1);
        Assert.areEqual(29, MC_AccountBannerController.calculateAge(birthdate),
            'Birthday tomorrow: age should be one less');
    }

    @isTest
    static void testCalculateAge_BirthdayToday() {
        Date birthdate = Date.today().addYears(-30);
        Assert.areEqual(30, MC_AccountBannerController.calculateAge(birthdate),
            'Birthday today: age should match the year difference');
    }

    @isTest
    static void testCalculateAge_BirthdayAlreadyOccurred() {
        Date birthdate = Date.today().addYears(-30).addDays(-1);
        Assert.areEqual(30, MC_AccountBannerController.calculateAge(birthdate),
            'Birthday already passed: age should match the year difference');
    }

    @isTest
    static void testCalculateAge_BirthdayMonthAlreadyPassed() {
        Date birthdate = Date.today().addYears(-30).addMonths(-1);
        Assert.areEqual(30, MC_AccountBannerController.calculateAge(birthdate),
            'Birthday month already passed: age should match the year difference');
    }
}
