@isTest
private class MedicalConditionsMobileCtrlTest {

    private static final String OBJ_ACCOUNT         = 'Account';
    private static final String LOOKUP_PARENT       = 'ParentId';
    private static final String MIN_USERNAME_PREFIX = 'mcmedtest.min.';

    // ------------------------------------------------------------------
    // Setup: user only (setup object) to avoid MIXED_DML_OPERATION
    // ------------------------------------------------------------------
    @TestSetup
    static void setupUsers() {
        List<Profile> minProfiles = [SELECT Id FROM Profile WHERE Name = 'Minimum Access - Salesforce' LIMIT 1];
        if (minProfiles.isEmpty()) {
            return;
        }
        insert new User(
            FirstName         = 'Medical',
            LastName          = 'TestUser',
            Alias             = 'medmin',
            Email             = 'medtest@mc-test.example.com',
            Username          = MIN_USERNAME_PREFIX + Datetime.now().getTime() + '@mc-test.example.com',
            ProfileId         = minProfiles[0].Id,
            TimeZoneSidKey    = 'Australia/Perth',
            LocaleSidKey      = 'en_AU',
            EmailEncodingKey  = 'UTF-8',
            LanguageLocaleKey = 'en_US'
        );
    }

    private static User getMinAccessUser() {
        String pattern = MIN_USERNAME_PREFIX + '%';
        List<User> users = [SELECT Id FROM User WHERE Username LIKE :pattern LIMIT 1];
        return users.isEmpty() ? null : users[0];
    }

    // ------------------------------------------------------------------
    // Data helpers. Account/ParentId is used as the generic parent-child
    // pair: Account always has RecordTypeId, RecordType.Name and a
    // filterable lookup, which the controller's queries rely on.
    // ------------------------------------------------------------------
    private static Account createParent() {
        return MC_TestDataFactory.grampiansAccountEmail();
    }

    private static List<Account> createChildren(Account parent, Integer count) {
        List<Account> children = new List<Account>();
        for (Integer i = 0; i < count; i++) {
            Account child = parent.clone(false, true, false, false);
            child.Name     = 'Child Account ' + i;
            child.ParentId = parent.Id;
            children.add(child);
        }
        insert children;
        return children;
    }

    private static RecordType getRecordType(Id recordTypeId) {
        return [SELECT Id, DeveloperName FROM RecordType WHERE Id = :recordTypeId];
    }

    private static RecordType getOtherAccountRecordType(Id excludedId) {
        List<RecordType> rts = [
            SELECT Id, DeveloperName FROM RecordType
            WHERE SObjectType = 'Account' AND Id != :excludedId
            LIMIT 1
        ];
        return rts.isEmpty() ? null : rts[0];
    }

    private static void assertMessage(MedicalConditionsMobileCtrl.RelatedListResult res, String fragment) {
        Assert.isNotNull(res, 'Result should never be null');
        Assert.isNotNull(res.message, 'A message should explain why nothing was returned');
        Assert.isTrue(res.message.contains(fragment), 'Unexpected message: ' + res.message);
        Assert.areEqual(0, res.records.size(), 'No records should be returned when a message is set');
        Assert.areEqual(0, res.totalCount, 'Total count should be 0 when a message is set');
    }

