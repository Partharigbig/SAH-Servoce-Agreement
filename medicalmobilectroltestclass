    @isTest
    static void testGetRelatedList_RecordTypeFilter_MatchingAndNonMatching() {
        Account parent = createParent();
        createChildren(parent, 2);
        RecordType matching = getRecordType(parent.RecordTypeId);

        MedicalConditionsMobileCtrl.RelatedListResult res = MedicalConditionsMobileCtrl.getRelatedList(
            parent.Id, OBJ_ACCOUNT, LOOKUP_PARENT, null, matching.DeveloperName, null);
        Assert.areEqual(matching.Id, res.recordTypeId, 'Record Type Id should be resolved from the developer name');
        Assert.areEqual(2, res.totalCount, 'Matching Record Type children should be counted');
        Assert.areEqual(2, res.records.size(), 'Matching Record Type children should be returned');

        RecordType other = getOtherAccountRecordType(parent.RecordTypeId);
        if (other != null) {
            MedicalConditionsMobileCtrl.RelatedListResult resOther = MedicalConditionsMobileCtrl.getRelatedList(
                parent.Id, OBJ_ACCOUNT, LOOKUP_PARENT, null, other.DeveloperName, null);
            Assert.areEqual(other.Id, resOther.recordTypeId, 'Record Type Id should be resolved');
            Assert.areEqual(0, resOther.totalCount, 'Other Record Type should exclude the children');
            Assert.areEqual(0, resOther.records.size(), 'Other Record Type should return no rows');
        }
    }

    // ==================================================================
    // getRelatedList: results, limits and flags
    // ==================================================================
    @isTest
    static void testGetRelatedList_ReturnsChildrenAndFlags() {
        Account parent = createParent();
        createChildren(parent, 2);

        MedicalConditionsMobileCtrl.RelatedListResult res = MedicalConditionsMobileCtrl.getRelatedList(
            parent.Id, OBJ_ACCOUNT, LOOKUP_PARENT, new List<String>{ 'Name', 'Phone' }, null, 10);

        Assert.isNull(res.message, 'No message expected on success');
        Assert.isTrue(res.accessible, 'Object should be accessible');
        Assert.isNotNull(res.createable, 'createable flag should be set');
        Assert.isNotNull(res.updateable, 'updateable flag should be set');
        Assert.isNotNull(res.objectLabel, 'Object label should be set');
        Assert.areEqual(2, res.totalCount, 'Total count should include both children');
        Assert.areEqual(2, res.records.size(), 'Both children should be returned');
        Assert.areEqual('Id', res.fields[0], 'Id should always be the first selected field');
        Assert.isTrue(res.fields.contains('Phone'), 'Requested field should be selected');
        Assert.isTrue(res.fields.contains('RecordTypeId'), 'RecordTypeId should be added when it exists');
        Assert.isTrue(res.fields.contains('RecordType.Name'), 'RecordType.Name should be added when it exists');
        Assert.areEqual(new Set<String>(res.fields).size(), res.fields.size(), 'Selected fields should not contain duplicates');
        Assert.isTrue(res.skippedFields.isEmpty(), 'Nothing should be skipped');
        Assert.isTrue(res.records[0].containsKey('Name'), 'Rows should be keyed by field path');
    }

