    // ==================================================================
    // getRelatedList: field planning and flattening
    // ==================================================================
    @isTest
    static void testGetRelatedList_FieldPlanning_SkipsInvalidAndDedupes() {
        Account parent = createParent();
        createChildren(parent, 1);

        List<String> requested = new List<String>{
            'Name', 'name',           // duplicate, different casing
            'Bogus__c',               // unknown field
            '', '   ', null,          // blanks are ignored, not reported
            'Bogus.Name',             // unknown relationship
            '.Name',                  // blank path segment
            'Name.Name',              // not a relationship
            'Parent.',                // relationship without a field
            'Parent.Name'             // valid relationship path
        };
        MedicalConditionsMobileCtrl.RelatedListResult res = MedicalConditionsMobileCtrl.getRelatedList(
            parent.Id, OBJ_ACCOUNT, LOOKUP_PARENT, requested, null, null);

        Assert.isNull(res.message, 'Bad field names should be skipped, not fail the query');
        Assert.areEqual(5, res.skippedFields.size(), 'Only unresolvable paths should be skipped: ' + res.skippedFields);
        Assert.isTrue(res.skippedFields.contains('Bogus__c'), 'Unknown field should be reported');
        Assert.isTrue(res.skippedFields.contains('Bogus.Name'), 'Unknown relationship should be reported');
        Assert.isTrue(res.skippedFields.contains('.Name'), 'Blank segment should be reported');
        Assert.isTrue(res.skippedFields.contains('Name.Name'), 'Non-relationship path should be reported');
        Assert.isTrue(res.skippedFields.contains('Parent.'), 'Dangling relationship should be reported');
        Assert.isTrue(res.fields.contains('Parent.Name'), 'Valid relationship path should be selected');
        Assert.areEqual(new Set<String>(res.fields).size(), res.fields.size(), 'Selected fields should not contain duplicates');

        Map<String, Object> row = res.records[0];
        Assert.areEqual(parent.Name, (String) row.get('Parent_Name'), 'Relationship paths should be flattened with underscores');
    }

    @isTest
    static void testGetRelatedList_Flatten_NullRelationshipYieldsNull() {
        Account parent = createParent();
        List<Account> children = createChildren(parent, 1);

        // Filtering by owner returns the parent too, which has no Parent account
        MedicalConditionsMobileCtrl.RelatedListResult res = MedicalConditionsMobileCtrl.getRelatedList(
            UserInfo.getUserId(), OBJ_ACCOUNT, 'OwnerId', new List<String>{ 'Parent.Name' }, null, null);

        Assert.isNull(res.message, 'Owner lookup should be valid');
        Boolean foundParent = false;
        Boolean foundChild = false;
        for (Map<String, Object> row : res.records) {
            Assert.isTrue(row.containsKey('Parent_Name'), 'Every row should have the flattened key');
            if ((Id) row.get('Id') == parent.Id) {
                foundParent = true;
                Assert.isNull(row.get('Parent_Name'), 'A record without a parent should flatten to null');
            } else if ((Id) row.get('Id') == children[0].Id) {
                foundChild = true;
                Assert.areEqual(parent.Name, (String) row.get('Parent_Name'), 'Child should carry the parent name');
            }
        }
        Assert.isTrue(foundParent && foundChild, 'Both the parent and child should be listed');
    }

