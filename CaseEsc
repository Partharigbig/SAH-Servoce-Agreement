    <description>R3DV-2088: overdue Case notification and escalation. All four branches the story
        defines are consolidated into ONE daily scheduled flow on Case rather than four separate
        automations, so ordering is deterministic and the backlog is swept once.

        Branch 1 - owner is a user, 1+ days overdue: Salesforce notification + email (once).
        Branch 2 - owner is a queue, 1+ days overdue: email to the TBD address (once).
        Branch 3 - owner is a user, 7+ days overdue: email to the owner&apos;s manager (once).
        Branch 4 - owner is a queue, 7+ days overdue: email to the TBD escalation address (once).

        TBD RECIPIENTS: both addresses the story left as &quot;[TBD email address]&quot; are held in the
        Maintenance_Notification__c hierarchy custom setting, so business can supply them without
        a code change and they can differ per sandbox.
        IDEMPOTENCY: Overdue_Notified__c and Overdue_Escalated__c are separate flags so the
        7-day escalation cannot be suppressed by the first alert having already fired.
        BULKIFICATION: one interview per record in batches of 200 with DML aggregated per
        element. The entry filter narrows to open Cases that have a Due Date; the overdue
        threshold and the two one-time flags are then evaluated by the flow&apos;s own decisions.
        NOTE: schedule-triggered flows do not accept filterFormula, so structured filters are
        used - verified by validation deploy.</description>
    <environments>Default</environments>
    <formulas>
        <description>R3DV-2088 AC3: Case Number (link), Subject, Priority, Status, Date Opened,
            Due Date.</description>
        <name>fCaseDetailBody</name>
        <dataType>String</dataType>
        <expression>&quot;Case Number: &quot; &amp; {!$Record.CaseNumber} &amp; BR() &amp;
&quot;Link: &quot; &amp; {!$Setup.Maintenance_Notification__c.Org_Base_URL__c} &amp; &quot;/&quot; &amp; {!$Record.Id} &amp; BR() &amp;
&quot;Subject: &quot; &amp; {!$Record.Subject} &amp; BR() &amp;
&quot;Priority: &quot; &amp; TEXT({!$Record.Priority}) &amp; BR() &amp;
&quot;Status: &quot; &amp; TEXT({!$Record.Status}) &amp; BR() &amp;
&quot;Date Opened: &quot; &amp; TEXT(DATEVALUE({!$Record.CreatedDate})) &amp; BR() &amp;
&quot;Due Date: &quot; &amp; TEXT(DATEVALUE({!$Record.Due_Date__c}))</expression>
    </formulas>
    <formulas>
        <description>R3DV-2088: escalation body adds Assigned To and Days Overdue.</description>
        <name>fEscalationBody</name>
        <dataType>String</dataType>
        <expression>&quot;Case Number: &quot; &amp; {!$Record.CaseNumber} &amp; BR() &amp;
&quot;Link: &quot; &amp; {!$Setup.Maintenance_Notification__c.Org_Base_URL__c} &amp; &quot;/&quot; &amp; {!$Record.Id} &amp; BR() &amp;
&quot;Subject: &quot; &amp; {!$Record.Subject} &amp; BR() &amp;
&quot;Assigned To: &quot; &amp; {!Get_Owner_User_for_Escalation.Name} &amp; BR() &amp;
&quot;Priority: &quot; &amp; TEXT({!$Record.Priority}) &amp; BR() &amp;
&quot;Status: &quot; &amp; TEXT({!$Record.Status}) &amp; BR() &amp;
&quot;Date Opened: &quot; &amp; TEXT(DATEVALUE({!$Record.CreatedDate})) &amp; BR() &amp;
&quot;Due Date: &quot; &amp; TEXT(DATEVALUE({!$Record.Due_Date__c})) &amp; BR() &amp;
&quot;Days Overdue: &quot; &amp; TEXT({!$Record.Days_Overdue__c})</expression>
    </formulas>
    <formulas>
        <name>fIsMaintenanceRecordType</name>
        <dataType>Boolean</dataType>
        <expression>OR({!$Record.RecordType.DeveloperName} = &quot;Reactive_Maintenance_Ticket&quot;,
   {!$Record.RecordType.DeveloperName} = &quot;Maintenance&quot;)</expression>
    </formulas>
    <formulas>
        <description>R3DV-2088 AC2 verbatim wording.</description>
        <name>fNotificationBody</name>
        <dataType>String</dataType>
